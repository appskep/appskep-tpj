# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# development | production
ENV=development

# --- server ---
SERVER_HOST=
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
# Caps every request body. Above the 2 MB service-image limit plus form overhead;
# the per-upload caps are enforced by the app and produce the friendly message,
# this only stops a body nobody meant to send. Minimum 3145728 (3 MB).
SERVER_MAX_BODY_BYTES=4194304

# --- rate limiting & client IP ---
# Requests per minute per client IP. 0 disables one.
RATE_LIMIT_BOOKING=20
RATE_LIMIT_PAYMENT=20
# Generous on purpose: Midtrans retries, and a refused notification means a
# customer who paid stays unpaid on the site.
RATE_LIMIT_WEBHOOK=120
# Comma-separated addresses or CIDR blocks whose X-Forwarded-For may be believed.
# EMPTY IS THE SAFE DEFAULT: with this unset the client address is the connecting
# socket, and no header can change it. Set it only to your reverse proxy —
# trusting a header from anywhere lets any caller forge their address and walk
# past the rate limits. Example: TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=

# --- app ---
APP_NAME=Terapi Pemuda Jompo
APP_URL=http://localhost:8080
APP_PAGE_SIZE=20
APP_TZ=Asia/Jakarta
# How often unpaid bookings past their expires_at release their slot. This is the
# upper bound on how long a slot stays held after its booking died, so keep it
# short. Must be greater than 0 — there is no "off".
EXPIRY_SWEEP_INTERVAL=1m

# --- database (MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=appskep_tpj
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# The database the test harness owns (Phase 13). It is DROPPED and recreated on
# every `make test`, then migrated from 0001_schema.sql and seeded — so it is
# always current with the schema and never needs `make db-fresh` of its own.
# internal/testsupport refuses any name that does not end in "_test", because a
# mis-set value here would otherwise drop DB_NAME above.
#
# Not read by the application: config.Load never looks at it.
TEST_DB_NAME=appskep_tpj_test

# --- Appskep SSO ---
# AUTH_SECRET must match the auth service's JWT HMAC key. It is required in every
# environment: it is the only thing that makes an inbound identity trustworthy,
# so an empty value fails the boot rather than accepting unverified tokens.
AUTH_URL=https://dev-auth.appskep.id
AUTH_SECRET=
AUTH_CLIENT_ID=
# Comma-separated Appskep user IDs bootstrapped to role=admin on first login.
# Keep in step with the admin row in seed_dev.sql. Example: ADMIN_USER_IDS=1,42
ADMIN_USER_IDS=

# --- session ---
# Signs the session cookie. Random, 32+ bytes, required in every environment.
# Generate with: openssl rand -base64 48
SESSION_KEY=
SESSION_NAME=tpj_session
SESSION_MAX_AGE=24h
SESSION_SECURE=false

# --- Midtrans ---
# The literal "midtrans.Production" selects production; anything else is sandbox.
MIDTRANS_ENV=midtrans.Sandbox
MIDTRANS_SERVER_KEY=
# Only needed to embed snap.js. The payment flow redirects to Snap's hosted page,
# so nothing reads this yet.
MIDTRANS_CLIENT_KEY=
# Namespaces our order IDs ("tpj-<uuid-v4>") inside Appskep's SHARED merchant
# account. Notifications carrying any other prefix are ignored. Must not contain
# a dash.
MIDTRANS_PREFIX=tpj
# Which channels the Snap page offers, comma-separated. Sent per transaction, so
# it never disturbs the shared account's own channel configuration.
#
# A SINGLE value makes Snap skip its method picker and open that channel's page
# directly — "qris" alone means "Bayar sekarang" lands the customer straight on
# the QR and its countdown. Add wallet deeplinks with "qris,gopay,shopeepay"
# (nicer on a phone, at the cost of a picker on desktop). The literal "all"
# sends nothing and restores whatever the account has active — the escape hatch
# for a channel that turns out not to be enabled on the shared merchant account.
MIDTRANS_ENABLED_PAYMENTS=qris
PAYMENT_EXPIRY_MINUTES=60
# Bounds one call to the Midtrans API. Keep it well under SERVER_WRITE_TIMEOUT.
MIDTRANS_TIMEOUT=15s

# --- SMTP (optional; unset = no-op email service) ---
# Email is OFF, not broken, when SMTP_HOST or SMTP_FROM_EMAIL is empty: the whole
# booking flow runs, one INFO line at startup says so, and nothing blocks.
#
# Port 465 is treated as implicit TLS; anything else negotiates STARTTLS when the
# server advertises it. Credentials are refused over an unencrypted connection to
# a non-loopback host, so a mail relay that stops offering STARTTLS produces a
# failed send rather than a password in the clear.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Terapi Pemuda Jompo
SMTP_FROM_EMAIL=
# Bounds one delivery, connection through QUIT.
SMTP_TIMEOUT=10s

# Local mail catcher for development — no auth, no TLS, inbox at :8025:
#   docker run --rm -p 1025:1025 -p 8025:8025 axllent/mailpit
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM_EMAIL=noreply@tpj.local

# --- Reminders ---
# The local hour (0-23) at or after which the H-1 reminder for tomorrow's paid
# and confirmed bookings goes out. A wall-clock hour, not an interval: a reminder
# that arrives at 03:00 is worse than none.
REMINDER_HOUR=9
# How often the ticker checks whether that hour has arrived. Coarse on purpose —
# the sweep does nothing before REMINDER_HOUR, and each booking is claimed once
# by a guarded UPDATE on reminder_sent_at, so running all day sends nothing twice.
REMINDER_SWEEP_INTERVAL=15m
